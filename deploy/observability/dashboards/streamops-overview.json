{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Latency Masked (Seconds)",
      "type": "stat",
      "targets": [
        { "expr": "sum(streamops_latency_masked_seconds_total)", "legendFormat": "Masked Latency" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 10 }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Speculative Hit Rate",
      "type": "gauge",
      "targets": [
        { "expr": "sum(streamops_intents_detected_total) / (sum(streamops_intents_detected_total) + 0.001) * 100", "legendFormat": "Hit Rate" }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Active Speculative Sandboxes",
      "type": "stat",
      "targets": [
        { "expr": "sum(streamops_active_sandboxes)", "legendFormat": "Active Pods" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Estimated Cloud FinOps Value Saved ($)",
      "type": "stat",
      "targets": [
        { "expr": "sum(streamops_finops_saved_usd_total)", "legendFormat": "USD Saved" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Stream-Ops Token Ingestion & Intent Trigger Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(streamops_tokens_processed_total[1m])", "legendFormat": "Tokens/sec" },
        { "expr": "rate(streamops_intents_detected_total[1m])", "legendFormat": "Intents Triggered/sec" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Pod Provisioning Duration Distribution",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(streamops_pod_provision_seconds_bucket[5m])) by (le))", "legendFormat": "P95 Provision Latency" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["streamops", "aiops", "llm"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Stream-Ops Speculative Control Plane Overview",
  "version": 1
}
